{
    "framework": "vite",
    "devCommand": "npm run dev:vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "regions": ["syd1"],
    "crons": [{ "path": "/api/cleanup", "schedule": "0 14 * * *" }],
    "rewrites": [
        { "source": "/start", "destination": "/index.html" },
        { "source": "/shop/:slug", "destination": "/index.html" },
        { "source": "/shop/:slug/privacy", "destination": "/index.html" },
        { "source": "/privacy", "destination": "/index.html" },
        { "source": "/terms", "destination": "/index.html" }
    ]
}
